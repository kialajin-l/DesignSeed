    "node-fetch": "^3.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  },
  "bin": {
    "designseed": "engine/cli.js"
  },
  "exports": {
    ".": "./engine/cove-protocol.js",
    "./crawler": "./crawler/cli.js",
