    "test": "node --test engine/__tests__/",
    "demo": "node engine/cli.js demo"
  },
  "keywords": [
    "design",
    "ai",
    "html",
    "style",
    "agent",
    "skill",
    "nexus",
    "ruleforge"
  ],
  "author": "",
